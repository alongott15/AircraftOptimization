# `make setup` copies this to .env and fills the two blank secrets below with random values.
# Never put real secrets in this file — it is committed.
APP_ENV=dev
APP_DATA_SOURCE=poc
APP_AUTH_MODE=local
# Local demo password for the seeded POC users (admin / planner / maint / ops) — generated by make setup
APP_DEMO_PASSWORD=
# Session signing key — generated by make setup (blank ⇒ random per process in dev; required in prod)
APP_JWT_SECRET=
APP_COOKIE_SECURE=false
APP_CORS_ORIGINS=http://localhost:5173
# Optional: freeze "now" for demos/tests, e.g. 2026-01-15T08:00:00Z
APP_FROZEN_NOW=
# Production only
APP_STORE_URL=
APP_VERTICA_DSN=
